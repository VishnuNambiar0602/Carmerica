# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GROQ_API_KEY: Required for the multi-agent chat support system.
# Get a free key at https://console.groq.com/keys
# Uses llama-3.1-8b-instant — fast, free tier, production-ready
GROQ_API_KEY="YOUR_GROQ_API_KEY"

# Backend infrastructure
PORT="5000"
NODE_ENV="development"
APP_NAME="CarMerica"
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"
ALLOWED_ORIGINS="http://localhost:3000"
JWT_EXPIRES_IN="2h"
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ADMIN_NAME="System Administrator"

# PostgreSQL / Supabase
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"
DATABASE_SSL="true"
DATABASE_POOL_SIZE="10"
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
SUPABASE_KYV_BUCKET="kyv-documents"

# Redis
REDIS_URL="redis://default:PASSWORD@HOST:6379"

# Email provider: configure one for password resets and invitations
MAIL_FROM="CarMerica <security@carmerica.com>"
MAIL_FROM_EMAIL="security@carmerica.com"
RESEND_API_KEY=""
SENDGRID_API_KEY=""

# Payments: configure Stripe or Razorpay
PAYMENT_PROVIDER="stripe"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# KYV uploads
KYV_MAX_BYTES="10485760"

# Optional AI/vector search
VECTOR_DB_URL=""
VECTOR_DB_API_KEY=""
