# ============================================
# CarMerica — Production Environment Variables
# ============================================
# Copy this to .env and fill in your values
# ============================================

# Server
PORT="5000"
NODE_ENV="development"
APP_NAME="CarMerica"

# REQUIRED in production: A secure random string for JWT signing
# Generate with: openssl rand -hex 64
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS="http://localhost:3000"
JWT_EXPIRES_IN="2h"
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ADMIN_NAME="System Administrator"

# --- PostgreSQL / Supabase ---
# Either DATABASE_URL (direct Postgres) or SUPABASE_URL + keys
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"
DATABASE_SSL="true"
DATABASE_POOL_SIZE="10"
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
SUPABASE_KYV_BUCKET="kyv-documents"

# --- Redis (optional, for caching) ---
REDIS_URL="redis://default:PASSWORD@HOST:6379"

# Email provider: configure one for password resets and invitations
MAIL_FROM="CarMerica <security@carmerica.com>"
MAIL_FROM_EMAIL="security@carmerica.com"
RESEND_API_KEY=""
SENDGRID_API_KEY=""

# Payments: configure Stripe or Razorpay
PAYMENT_PROVIDER="stripe"
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# KYV uploads
KYV_MAX_BYTES="10485760"

# --- Groq AI (optional, fallback mode if not set) ---
GROQ_API_KEY="YOUR_GROQ_API_KEY_HERE"
GROQ_MODEL="llama-3.1-8b-instant"

# --- Optional AI/vector search ---
VECTOR_DB_URL=""
VECTOR_DB_API_KEY=""

# --- Gemini (legacy) ---
GEMINI_API_KEY=""
APP_URL=""
